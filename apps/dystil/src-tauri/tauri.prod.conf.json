{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dystil",
  "identifier": "dystil",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "publisher": "Second Order Systemss",
    "category": "DeveloperTool",
    "shortDescription": "24/7 memory for your desktop",
    "longDescription": "24/7 memory for your desktop. 100% local. You own your data.",
    "copyright": "",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [
      "bun",
      "dystil-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/dystil-logo-tray-failed.png",
      "icons/dystil-logo-tray-black.png"
    ],
    "resources": [
      "assets/*",
      "icons/1024x1024.png",
      "PermissionFlow_PermissionFlow.bundle"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://artifacts.2os.ai/dystil/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMUZFQTkyN0VGNkY2NUYKUldSZjl2WitrdW9mTGpXS3RQYnRPN0NGMWlCV0Y3S3JMdjhCRkg5eXVmaXZkZDh6NlIyem1KM0YK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "dystil"
        ]
      },
      "mobile": [
        {
          "host": "dystil.dev",
          "pathPrefix": [
            "/auth"
          ]
        },
        {
          "host": "dystil.dev",
          "pathPrefix": [
            "/stripe-connect"
          ]
        },
        {
          "host": "dystil.dev",
          "pathPrefix": [
            "/purchase-successful"
          ]
        },
        {
          "host": "dystil.dev",
          "pathPrefix": [
            "/settings"
          ]
        },
        {
          "host": "dystil.dev",
          "pathPrefix": [
            "/changelog"
          ]
        },
        {
          "host": "dystil.dev",
          "pathPrefix": [
            "/onboarding"
          ]
        },
        {
          "host": "dystil.dev",
          "pathPrefix": [
            "/status"
          ]
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "dystil_main",
      "iconPath": "icons/1024x1024.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": true
    },
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.dystil/**"
        ]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
