# Enterprise production build configuration.
# Copy this file to .env.build and replace the placeholder values.

DYSTIL_CLOUD_BASE_URL="https://coconut.2os.ai"
DYSTIL_TELEMETRY_ENDPOINT="https://coconut.2os.ai/v1/telemetry"

# Prefer a local key file. Generate one with:
#   bunx tauri signer generate -w "$HOME/.tauri/dystil.key"
TAURI_SIGNING_PRIVATE_KEY_FILE=""
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# The script uses the Developer ID certificate already installed in your
# login keychain. Leave this empty to auto-detect it, or set the exact identity
# shown by: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=""

# Notarization uses an app-specific Apple ID password.
APPLE_ID=""
APPLE_PASSWORD=""
APPLE_TEAM_ID=""
