# Include the limit_req_zone declaration once in Nginx's `http {}` block.
# Tune the rate from observed traffic; five-minute desktop exports should not
# approach this under normal operation.
limit_req_zone $binary_remote_addr zone=dystil_telemetry:10m rate=30r/m;

# Include these locations in the existing TLS server that already proxies
# dystil-api. OpenObserve itself must not be exposed here.
location ^~ /v1/telemetry/ {
    client_max_body_size 256k;
    limit_req zone=dystil_telemetry burst=20 nodelay;
    proxy_connect_timeout 2s;
    proxy_read_timeout 6s;
    proxy_send_timeout 6s;
    proxy_pass http://dystil_api_upstream;

    # Preserve device authentication for dystil-api. Do not log the header.
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type $content_type;
}
