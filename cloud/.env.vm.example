# Linux VM production envs.

# These values initialize the self-hosted Postgres container on first startup.
# Keep the credentials consistent with both database URLs below.
POSTGRES_DB=work_insights
POSTGRES_USER=work_insights
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

WORK_INSIGHTS_DATABASE_URL=postgres://work_insights:replace-with-url-encoded-database-password@prod-postgres:5432/work_insights
DATABASE_URL=postgres://work_insights:replace-with-url-encoded-database-password@prod-postgres:5432/work_insights

WORK_INSIGHTS_BIND_ADDR=0.0.0.0:8089
AUTH_INTERNAL_URL=http://dystil-auth:3001
AUTH_HOST=0.0.0.0
AUTH_PORT=3001

BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Dystil <no-reply@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

WORK_INSIGHTS_AI_BASE_URL=https://ai-gateway.example.com/v1
WORK_INSIGHTS_AI_API_KEY=
WORK_INSIGHTS_AI_SEGMENT_MODEL=qwen2.5:7b-instruct
WORK_INSIGHTS_AI_DAILY_MODEL=qwen2.5:14b-instruct
WORK_INSIGHTS_SEGMENT_PROMPT_VERSION=stage3-segment-v1
WORK_INSIGHTS_DAILY_PROMPT_VERSION=stage3-daily-v1

RUST_LOG=info

# --- Cloudflare R2 storage (org icons) ---
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
