# Copy these values into cloud/.env.docker; do not commit the resulting file.
OPENOBSERVE_ROOT_EMAIL=telemetry-admin@example.test
OPENOBSERVE_ROOT_PASSWORD=replace-with-a-long-unique-password

# Basic base64(root-email:root-password). Kept only on the API/OpenObserve network.
TELEMETRY_OPENOBSERVE_AUTHORIZATION=Basic replace-with-base64-credentials
TELEMETRY_OPENOBSERVE_ORG=default
TELEMETRY_RELAY_ENABLED=true
