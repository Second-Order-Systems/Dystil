# A deliberately small, private-only image for OpenObserve dashboard-as-code.
FROM alpine:3.21.3

RUN apk add --no-cache bash curl jq

WORKDIR /app
COPY openobserve/provision-dashboard.sh /app/provision-dashboard.sh
COPY openobserve/dashboards/dystil-desktop-operational.json /app/dashboards/dystil-desktop-operational.json

USER 65532:65532
CMD ["/bin/bash", "/app/provision-dashboard.sh"]
