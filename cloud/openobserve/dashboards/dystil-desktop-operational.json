              "promql_labels": [], "promql_operations": []
            },
            "config": { "promql_legend": "Dystil data" }
          }],
          "layout": { "x": 128, "y": 18, "w": 64, "h": 18, "i": 5 }
        },
        {
          "id": "storage-available",
          "type": "line",
          "title": "Available disk space for Dystil",
          "description": "Free space on the filesystem containing Dystil's data directory, sampled every 15 minutes.",
          "config": { "show_legends": false, "unit": "bytes", "show_gridlines": true, "connect_nulls": false },
          "queryType": "promql",
          "queries": [{
            "query": "dystil_storage_available_bytes{}",
            "vrlFunctionQuery": null,
