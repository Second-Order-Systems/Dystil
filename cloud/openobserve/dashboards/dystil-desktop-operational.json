            "config": { "promql_legend": "Dystil CPU" }
          }],
          "layout": { "x": 64, "y": 18, "w": 64, "h": 18, "i": 4 }
        },
        {
          "id": "storage-data",
          "type": "line",
          "title": "Dystil local data used",
