# Local Docker Compose envs.

WORK_INSIGHTS_DATABASE_URL=postgres://work_insights:work_insights@postgres:5432/work_insights
DATABASE_URL=postgres://work_insights:work_insights@postgres:5432/work_insights

WORK_INSIGHTS_BIND_ADDR=0.0.0.0:8089
# Auth runs inside the same container — always localhost.
AUTH_INTERNAL_URL=http://127.0.0.1:3001
AUTH_HOST=127.0.0.1
AUTH_PORT=3001

# MEMORY_INTERNAL_URL is set by docker-compose.memory.yml. Leave it unset for
# the base deployment so the image's fail-fast default remains active.
MEMORY_INTERNAL_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
MEMORY_QUERY_UPSTREAM_TIMEOUT_SECONDS=120
MEMORY_QUERY_MAX_BODY_BYTES=32768
MEMORY_QUERY_RATE_LIMIT_PER_MINUTE=10

MEMORY_GENERATION_BASE_URL=https://example.openai.azure.com/openai/v1
MEMORY_GENERATION_MODEL=gpt-5.4-nano
MEMORY_GENERATION_API_KEY=
MEMORY_GENERATION_TIMEOUT_SECONDS=90
MEMORY_GENERATION_MAX_OUTPUT_TOKENS=4096
MEMORY_GENERATION_RESPONSE_FORMAT=json_schema

MEMORY_EMBEDDING_BASE_URL=https://example.openai.azure.com/openai/v1
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_QUERY_MAX_IN_FLIGHT=8
MEMORY_QUERY_MAX_INPUT_TOKENS=16000

WORK_INSIGHTS_STORAGE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
WORK_INSIGHTS_STORAGE_BUCKET=bucket_name
WORK_INSIGHTS_STORAGE_REGION=eu-central-003
WORK_INSIGHTS_STORAGE_ACCESS_KEY_ID=key_id
WORK_INSIGHTS_STORAGE_SECRET_ACCESS_KEY=replace-with-backblaze-application-key-secret
WORK_INSIGHTS_STORAGE_PRESIGN_EXPIRY_SECS=900

# --- Cloudflare R2 storage (org icons) ---
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

BETTER_AUTH_URL=http://localhost:8089
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Dystil <no-reply@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

WORK_INSIGHTS_AI_BASE_URL=http://host.docker.internal:11434/v1
WORK_INSIGHTS_AI_API_KEY=
WORK_INSIGHTS_AI_SEGMENT_MODEL=qwen2.5:7b-instruct
WORK_INSIGHTS_AI_DAILY_MODEL=qwen2.5:14b-instruct
WORK_INSIGHTS_SEGMENT_PROMPT_VERSION=stage3-segment-v1
WORK_INSIGHTS_DAILY_PROMPT_VERSION=stage3-daily-v1

RUST_LOG=info
