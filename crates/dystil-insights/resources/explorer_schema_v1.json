{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": {
    "schema_version": { "const": 1 },
    "observations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_id", "statement", "certainty", "occurred_at", "evidence_ids"],
        "properties": {
          "local_id": { "type": "string" },
          "statement": { "type": "string" },
          "certainty": { "enum": ["explicit", "strongly_implied", "tentative"] },
          "occurred_at": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
