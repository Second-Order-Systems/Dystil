{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "considered_observation_ids", "opportunities"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "considered_observation_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "opportunities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id", "existing_opportunity_id", "construct", "summary", "signature",
          "occurrences_to_add", "withdraw_current_finding", "retire",
          "transfer_established", "authorship_established", "cadence",
          "unresolved_questions", "evidence_quality", "handoff", "finding",
          "rank_signals", "automation_potential"
        ],
        "properties": {
          "local_id": { "type": "string" },
          "existing_opportunity_id": { "type": ["string", "null"] },
          "construct": { "type": "string", "enum": ["recognition", "manual_transfer", "unchanged_repetition", "temporal_pattern", "repeated_composition"] },
          "summary": { "type": "string" },
          "signature": { "type": "string" },
          "occurrences_to_add": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["local_id", "observation_ids", "evidence_ids", "steps", "distinctness_basis"],
              "properties": {
                "local_id": { "type": "string" },
                "observation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "distinctness_basis": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "withdraw_current_finding": { "type": "boolean" },
          "retire": { "type": "boolean" },
          "transfer_established": { "type": "boolean" },
          "authorship_established": { "type": "boolean" },
          "cadence": { "type": "string", "enum": ["none", "daily", "weekly", "monthly"] },
          "unresolved_questions": { "type": "array", "items": { "type": "string" } },
          "evidence_quality": { "type": "string", "enum": ["high", "medium", "low"] },
          "handoff": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "body", "capability_id"],
                "properties": {
                  "kind": { "type": "string", "enum": ["prompt", "saved_prompt", "existing_capability", "runbook"] },
                  "title": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "body": { "type": "string", "minLength": 1, "maxLength": 12000 },
                  "capability_id": { "type": ["string", "null"] }
                }
              }
            ]
          },
          "finding": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["claim", "why_worth_fixing", "evidence_ids"],
                "properties": {
                  "claim": { "type": "string" },
                  "why_worth_fixing": { "type": "string" },
                  "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              }
            ]
          },
          "rank_signals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actionability", "estimated_burden", "novelty", "user_relevance", "sensitivity_risk"],
            "properties": {
              "actionability": { "type": "integer", "minimum": 0, "maximum": 3 },
              "estimated_burden": { "type": "integer", "minimum": 0, "maximum": 3 },
              "novelty": { "type": "integer", "minimum": 0, "maximum": 3 },
              "user_relevance": { "type": "integer", "minimum": 0, "maximum": 3 },
              "sensitivity_risk": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
          },
          "automation_potential": { "type": "boolean" }
        }
      }
    }
  }
}
